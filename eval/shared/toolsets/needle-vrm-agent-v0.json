{
  "toolset_id": "needle-vrm-agent-v0",
  "description": "Closed home-agent tools for needle-zh visual EVAL. Slot values are enums, never query substrings. Illegal shop/dish pairs are eval-gold [] not schema-invalid.",
  "tools": [
    {
      "name": "nod",
      "description": "Nod the head (agree / acknowledge).",
      "parameters": {"type": "object", "properties": {}, "required": []}
    },
    {
      "name": "shake_head",
      "description": "Shake the head (refuse / disagree).",
      "parameters": {"type": "object", "properties": {}, "required": []}
    },
    {
      "name": "come_here",
      "description": "Walk toward the user.",
      "parameters": {"type": "object", "properties": {}, "required": []}
    },
    {
      "name": "stop",
      "description": "Stop moving and idle.",
      "parameters": {"type": "object", "properties": {}, "required": []}
    },
    {
      "name": "point",
      "description": "Point at a closed-set target.",
      "parameters": {
        "type": "object",
        "properties": {
          "target": {"type": "string", "enum": ["left", "right", "user"]}
        },
        "required": ["target"]
      }
    },
    {
      "name": "wave",
      "description": "Wave a hand.",
      "parameters": {"type": "object", "properties": {}, "required": []}
    },
    {
      "name": "bow",
      "description": "Bow once.",
      "parameters": {"type": "object", "properties": {}, "required": []}
    },
    {
      "name": "sit",
      "description": "Sit down.",
      "parameters": {"type": "object", "properties": {}, "required": []}
    },
    {
      "name": "stand",
      "description": "Stand up.",
      "parameters": {"type": "object", "properties": {}, "required": []}
    },
    {
      "name": "go_to",
      "description": "Walk to a named place in the home scene.",
      "parameters": {
        "type": "object",
        "properties": {
          "place": {"type": "string", "enum": ["kitchen", "living", "entry", "trash"]}
        },
        "required": ["place"]
      }
    },
    {
      "name": "set_switch",
      "description": "Toggle a named light switch.",
      "parameters": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "enum": ["kitchen_light", "living_light"]},
          "on": {"type": "boolean"}
        },
        "required": ["id", "on"]
      }
    },
    {
      "name": "open_door",
      "description": "Open a named door.",
      "parameters": {
        "type": "object",
        "properties": {
          "door": {"type": "string", "enum": ["front", "back"]}
        },
        "required": ["door"]
      }
    },
    {
      "name": "close_door",
      "description": "Close a named door.",
      "parameters": {
        "type": "object",
        "properties": {
          "door": {"type": "string", "enum": ["front", "back"]}
        },
        "required": ["door"]
      }
    },
    {
      "name": "take_out_trash",
      "description": "Take the household trash out.",
      "parameters": {"type": "object", "properties": {}, "required": []}
    },
    {
      "name": "order_food",
      "description": "Place a food order. Legal pairs: 兰州拉面+牛肉面, 麦当劳+巨无霸.",
      "parameters": {
        "type": "object",
        "properties": {
          "shop": {"type": "string", "enum": ["兰州拉面", "麦当劳"]},
          "dish": {"type": "string", "enum": ["牛肉面", "巨无霸"]}
        },
        "required": ["shop", "dish"]
      }
    },
    {
      "name": "cancel_order",
      "description": "Cancel the in-progress food order.",
      "parameters": {"type": "object", "properties": {}, "required": []}
    }
  ]
}
