{
  "toolset_id": "mei-retail-v0",
  "description": "Holdout-unseen retail schema. Names/slots must not appear in mei-tool-sft-v1 train.",
  "split": "holdout",
  "tools": [
    {
      "name": "book_table",
      "description": "Reserve a dining table.",
      "parameters": {
        "type": "object",
        "properties": {
          "party_size": {"type": "integer", "minimum": 1, "maximum": 12},
          "outdoor": {"type": "boolean"}
        },
        "required": ["party_size"]
      }
    },
    {
      "name": "charge_card",
      "description": "Charge a payment card.",
      "parameters": {
        "type": "object",
        "properties": {
          "amount": {"type": "number"},
          "currency": {"type": "string", "enum": ["CNY", "USD"]}
        },
        "required": ["amount", "currency"]
      }
    },
    {
      "name": "print_label",
      "description": "Print a sku barcode label.",
      "parameters": {
        "type": "object",
        "properties": {
          "sku": {"type": "string"}
        },
        "required": ["sku"]
      }
    }
  ]
}
