{
  "toolset_id": "mei-type-v0",
  "description": "Four-scalar type-stress schema (string/boolean/integer/number).",
  "split": "train",
  "tools": [
    {
      "name": "echo_text",
      "description": "Echo a canonical text token.",
      "parameters": {
        "type": "object",
        "properties": {
          "text": {"type": "string", "enum": ["alpha", "beta", "gamma"]}
        },
        "required": ["text"]
      }
    },
    {
      "name": "set_flag",
      "description": "Set a boolean flag.",
      "parameters": {
        "type": "object",
        "properties": {
          "on": {"type": "boolean"}
        },
        "required": ["on"]
      }
    },
    {
      "name": "set_count",
      "description": "Set an integer count.",
      "parameters": {
        "type": "object",
        "properties": {
          "n": {"type": "integer"}
        },
        "required": ["n"]
      }
    },
    {
      "name": "set_rate",
      "description": "Set a numeric rate.",
      "parameters": {
        "type": "object",
        "properties": {
          "x": {"type": "number"}
        },
        "required": ["x"]
      }
    }
  ]
}
