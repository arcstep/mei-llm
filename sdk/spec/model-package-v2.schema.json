{
  "$id": "mei-model-package-v2",
  "title": "MeiModelPackageV2",
  "type": "object",
  "required": [
    "package_format", "product", "package_id", "runtime_min", "contracts",
    "architecture", "runtime_profile", "tokenizer", "tensor_container", "files", "heads", "capabilities",
    "training_receipts", "resources", "release_class"
  ],
  "additionalProperties": false,
  "properties": {
    "package_format": { "const": "mei-model-package-v2" },
    "product": { "const": "mei-1.0-51m" },
    "package_id": { "type": "string", "minLength": 1 },
    "runtime_min": { "const": "mei-runtime-abi-2" },
    "parent_package_id": { "type": ["string", "null"] },
    "contracts": {
      "type": "object",
      "required": ["weight_contract_sha256", "runtime_profile_sha256", "training_aux_sha256"],
      "additionalProperties": false,
      "properties": {
        "weight_contract_sha256": {
          "const": "c468b96453f0a377b1ffbcfef00ed9e108c82b2c44847ee5345509a181581d9b"
        },
        "runtime_profile_sha256": {
          "const": "74839b08155e624f14318ca8646166ddc68ee6496720dedac26aa91fdc8bdf43"
        },
        "training_aux_sha256": {
          "const": "83849db3926693e49c0896a58c172ae15e4b203550cee0ef12a4c37a8c1d48ac"
        }
      }
    },
    "architecture": {
      "type": "object",
      "required": [
        "id", "d_model", "n_layers", "n_heads", "n_kv_heads", "head_dim", "vocab_size",
        "max_seq_len", "parameter_count", "rope_theta", "engram_layers", "engram_orders",
        "engram_slots", "engram_conv_taps", "mhc_lanes", "sinkhorn_iters", "tie_embeddings",
        "rms_eps", "conf_probes", "mlp", "confidence_head"
      ],
      "properties": {
        "id": { "const": "mei-1.0-51m-arch-v1" }, "d_model": { "const": 512 },
        "n_layers": { "const": 27 }, "n_heads": { "const": 8 },
        "n_kv_heads": { "const": 4 }, "head_dim": { "const": 64 },
        "vocab_size": { "const": 24000 }, "max_seq_len": { "const": 2048 },
        "parameter_count": { "const": 51463797 }, "rope_theta": { "const": 100000 },
        "engram_layers": { "const": [2, 15] },
        "engram_orders": { "const": [2, 3] },
        "engram_slots": { "const": 8192 }, "engram_conv_taps": { "const": 4 },
        "mhc_lanes": { "const": 4 }, "sinkhorn_iters": { "const": 20 },
        "tie_embeddings": { "const": true }, "rms_eps": { "const": 0.000001 },
        "conf_probes": { "const": 8 },
        "mlp": { "const": "FixedWalshHadamardMLP" },
        "confidence_head": { "const": true }
      },
      "additionalProperties": false
    },
    "runtime_profile": {
      "type": "object",
      "required": ["max_context_tokens", "stable_prefix_tokens", "rolling_window_tokens", "default_output_tokens", "kv_dtype", "activation_dtype"],
      "additionalProperties": false,
      "properties": {
        "max_context_tokens": { "const": 2048 },
        "stable_prefix_tokens": { "const": 1024 },
        "rolling_window_tokens": { "const": 256 },
        "default_output_tokens": { "const": 128 },
        "kv_dtype": { "const": "i8" },
        "activation_dtype": { "const": "i8" }
      }
    },
    "runtime_quantization": {
      "description": "Optional on superseded diagnostic v2 packages; required for current product capability.",
      "type": "object",
      "required": [
        "weight_math_id", "activation_semantics_id", "activation_sites",
        "activation_q_quantized", "activation_reconstruction_dtype",
        "kv_semantics_id", "kv_sites", "kv_storage_dtype",
        "kv_scale_granularity", "int8_code_min", "int8_code_max",
        "scale_denominator"
      ],
      "additionalProperties": false,
      "properties": {
        "weight_math_id": { "const": "mei-cq-v2-g128-wht-codebook" },
        "activation_semantics_id": { "const": "int8-symmetric-per-last-axis-vector-qdq-forward_identity-backward-v2" },
        "activation_sites": { "const": ["engram_input", "attention_input", "attention_output", "lm_head_input"] },
        "activation_q_quantized": { "const": false },
        "activation_reconstruction_dtype": { "const": "f32" },
        "kv_semantics_id": { "const": "mei-int8-kv-per-head-vector-qdq-forward_identity-backward-v1" },
        "kv_sites": { "const": ["attention_key_after_rope", "attention_value"] },
        "kv_storage_dtype": { "const": "int8" },
        "kv_scale_granularity": { "const": "per-head-vector" },
        "int8_code_min": { "const": -128 },
        "int8_code_max": { "const": 127 },
        "scale_denominator": { "const": 127 }
      }
    },
    "tokenizer": {
      "type": "object",
      "required": ["id", "file", "sha256", "pad_id", "eos_id", "bos_id", "unk_id"],
      "additionalProperties": false,
      "properties": {
        "id": { "const": "zh-24k-v1" }, "file": { "$ref": "#/$defs/safe_path" },
        "sha256": { "$ref": "#/$defs/sha256" }, "vocab_file": { "$ref": "#/$defs/safe_path" },
        "vocab_sha256": { "$ref": "#/$defs/sha256" },
        "pad_id": { "const": 0 }, "eos_id": { "const": 1 },
        "bos_id": { "const": 2 }, "unk_id": { "const": 3 }
      }
    },
    "tensor_container": {
      "type": "object",
      "required": ["file", "format", "sha256", "payload_bytes", "quant_math_id", "directory"],
      "additionalProperties": false,
      "properties": {
        "file": { "$ref": "#/$defs/safe_path" },
        "format": { "const": "mei-cq-tensor-v2" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "payload_bytes": { "type": "integer", "minimum": 1 },
        "quant_math_id": { "const": "mei-cq-v2-g128-wht-codebook" },
        "directory": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tensor_entry" } }
      }
    },
    "files": {
      "description": "Complete payload-file inventory. mei-model.json is the sole self-hash exception.",
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/file_entry" }
    },
    "heads": {
      "type": "object",
      "required": ["lm", "contrastive", "mw_disposition", "confidence"],
      "additionalProperties": false,
      "properties": {
        "lm": { "$ref": "#/$defs/head" }, "contrastive": { "$ref": "#/$defs/head" },
        "mw_disposition": { "$ref": "#/$defs/head" }, "confidence": { "$ref": "#/$defs/head" },
        "narration_adapter": { "$ref": "#/$defs/head" }
      }
    },
    "capabilities": {
      "type": "object",
      "required": ["retrieval", "full_call", "mw_disposition", "confidence", "multi_step"],
      "additionalProperties": false,
      "properties": {
        "retrieval": { "type": "boolean" }, "full_call": { "type": "boolean" },
        "mw_disposition": { "type": "boolean" }, "confidence": { "type": "boolean" },
        "multi_step": { "type": "boolean" }, "narration": { "type": "boolean" }
      }
    },
    "training_receipts": {
      "description": "Every hash must resolve to exactly one files[] entry with role=training_receipt.",
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "resources": {
      "type": "object",
      "required": ["package_bytes", "rust_session_peak_bytes", "wasm_heap_peak_bytes"],
      "additionalProperties": false,
      "properties": {
        "package_bytes": { "type": "integer", "minimum": 0 },
        "rust_session_peak_bytes": { "type": "integer", "minimum": 0 },
        "wasm_heap_peak_bytes": { "type": "integer", "minimum": 0 },
        "measurement_receipt": {
          "type": "object",
          "required": ["file", "sha256"],
          "additionalProperties": false,
          "properties": {
            "file": { "$ref": "#/$defs/safe_path" },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "release_class": { "enum": ["experimental", "candidate", "release"] }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "safe_path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" },
    "head": {
      "type": "object",
      "required": ["present", "trained", "status", "tensor_prefixes"],
      "additionalProperties": false,
      "properties": {
        "present": { "type": "boolean" }, "trained": { "type": "boolean" },
        "status": { "enum": ["ready", "untrained", "missing", "disabled"] },
        "tensor_prefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]+(?:\\.[A-Za-z0-9_]+)*$"
          }
        },
        "training_receipt_sha256": { "$ref": "#/$defs/sha256" },
        "label_codebook_sha256": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "ready" } },
            "required": ["status"]
          },
          "then": { "required": ["training_receipt_sha256"] }
        }
      ]
    },
    "range": {
      "type": "object", "required": ["offset", "nbytes"], "additionalProperties": false,
      "properties": { "offset": { "type": "integer", "minimum": 0 }, "nbytes": { "type": "integer", "minimum": 0 } }
    },
    "file_entry": {
      "type": "object",
      "required": ["path", "sha256", "nbytes", "role"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/safe_path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "nbytes": { "type": "integer", "minimum": 0 },
        "role": {
          "enum": ["tokenizer", "tensor_container", "tool_index", "training_receipt", "head_codebook", "resource_receipt", "auxiliary"]
        }
      }
    },
    "tensor_entry": {
      "type": "object",
      "required": ["name", "role", "shape", "n_params", "dtype", "data", "transform", "codebook"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]+(?:\\.[A-Za-z0-9_]+)*$"
        },
        "role": { "enum": ["lm", "contrastive", "mw_disposition", "confidence", "narration_adapter"] },
        "shape": {
          "description": "Tensor dimensions in row-major order. The empty array is the canonical scalar shape and has n_params=1.",
          "type": "array",
          "items": { "type": "integer", "minimum": 1 }
        },
        "n_params": { "type": "integer", "minimum": 1 },
        "dtype": { "enum": ["cq2", "cq4", "f16", "f32", "i8"] },
        "data": { "$ref": "#/$defs/range" }, "scales": { "$ref": "#/$defs/range" },
        "bit_map": { "$ref": "#/$defs/range" },
        "group_size": { "type": "integer", "const": 128 },
        "transform": { "enum": ["wht", "none"] },
        "codebook": { "enum": ["gaussian-lloyd-q2-v1", "gaussian-lloyd-q4-v1", "none"] }
      },
      "allOf": [
        {
          "if": { "properties": { "dtype": { "const": "cq2" } }, "required": ["dtype"] },
          "then": {
            "required": ["scales", "bit_map", "group_size"],
            "properties": {
              "transform": { "const": "wht" },
              "codebook": { "const": "gaussian-lloyd-q2-v1" }
            }
          }
        },
        {
          "if": { "properties": { "dtype": { "const": "cq4" } }, "required": ["dtype"] },
          "then": {
            "required": ["scales", "bit_map", "group_size"],
            "properties": {
              "transform": { "const": "wht" },
              "codebook": { "const": "gaussian-lloyd-q4-v1" }
            }
          }
        },
        {
          "if": {
            "properties": { "dtype": { "enum": ["f16", "f32", "i8"] } },
            "required": ["dtype"]
          },
          "then": {
            "properties": {
              "transform": { "const": "none" },
              "codebook": { "const": "none" }
            },
            "not": {
              "anyOf": [
                { "required": ["scales"] },
                { "required": ["bit_map"] },
                { "required": ["group_size"] }
              ]
            }
          }
        }
      ]
    }
  }
}
