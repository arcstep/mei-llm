{
  "$id": "mei-tool-index-v2",
  "title": "MeiToolIndexV2",
  "type": "object",
  "required": [
    "format", "fingerprint", "catalog_sha256", "model_sha256", "head_sha256",
    "tokenizer_sha256", "serializer_id", "dtype", "normalized", "dimension", "records"
  ],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "mei-tool-index-v2" },
    "fingerprint": { "$ref": "#/$defs/sha256" },
    "catalog_sha256": { "$ref": "#/$defs/sha256" },
    "model_sha256": { "$ref": "#/$defs/sha256" },
    "head_sha256": { "$ref": "#/$defs/sha256" },
    "tokenizer_sha256": { "$ref": "#/$defs/sha256" },
    "serializer_id": { "const": "mei-tool-call-serializer-v2" },
    "dtype": { "const": "float16" },
    "normalized": { "const": true },
    "dimension": { "type": "integer", "minimum": 0 },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "record": {
      "type": "object",
      "required": ["tool_id", "schema", "schema_sha256", "embedding_f16_base64"],
      "additionalProperties": false,
      "properties": {
        "tool_id": { "type": "string", "minLength": 1 },
        "schema": { "type": "object" },
        "schema_sha256": { "$ref": "#/$defs/sha256" },
        "embedding_f16_base64": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    }
  }
}
