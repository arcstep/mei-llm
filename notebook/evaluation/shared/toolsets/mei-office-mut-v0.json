{
  "toolset_id": "mei-office-mut-v0",
  "description": "Schema mutation of mei-office-v0: extra required + enum change. Eval-only.",
  "split": "eval-mutation",
  "parent_toolset_id": "mei-office-v0",
  "tools": [
    {
      "name": "create_event",
      "description": "Create a calendar event.",
      "parameters": {
        "type": "object",
        "properties": {
          "title": {"type": "string", "enum": ["standup", "review", "1:1"]},
          "duration_min": {"type": "integer", "minimum": 1, "maximum": 480},
          "all_day": {"type": "boolean"}
        },
        "required": ["title", "duration_min"]
      }
    },
    {
      "name": "set_volume",
      "description": "Set playback volume from 0 to 10.",
      "parameters": {
        "type": "object",
        "properties": {
          "level": {"type": "integer", "minimum": 0, "maximum": 10}
        },
        "required": ["level"]
      }
    },
    {
      "name": "lookup_price",
      "description": "Look up a unit price times quantity.",
      "parameters": {
        "type": "object",
        "properties": {
          "item": {"type": "string"},
          "qty": {"type": "number"}
        },
        "required": ["item", "qty"]
      }
    }
  ]
}
