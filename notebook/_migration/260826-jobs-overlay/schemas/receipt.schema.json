{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mei-llm://jobs/receipt.schema.json",
  "title": "mei-llm Job Receipt",
  "type": "object",
  "additionalProperties": true,
  "required": ["job_id", "topic", "status", "publish_policy"],
  "properties": {
    "job_id": { "type": "string" },
    "topic": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["draft", "accepted", "failed", "archived"]
    },
    "publish_policy": {
      "type": "string",
      "enum": ["promote_only", "in_place_register", "none"]
    },
    "work_dir": { "type": ["string", "null"] },
    "publish_corpus_id": { "type": ["string", "null"] },
    "publish_path": { "type": ["string", "null"] },
    "gates": { "type": "object" },
    "unique_train_tokens": { "type": ["integer", "null"] },
    "spend_cny": { "type": ["number", "null"] },
    "note": { "type": "string" }
  }
}
