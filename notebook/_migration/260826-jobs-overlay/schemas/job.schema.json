{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mei-llm://jobs/job.schema.json",
  "title": "mei-llm Job Card",
  "type": "object",
  "additionalProperties": true,
  "required": ["job_id", "topic", "kind", "status", "work_dir"],
  "properties": {
    "job_id": { "type": "string", "pattern": "^[0-9]{6}-[0-9]{2}-[a-z0-9-]+$" },
    "topic": { "type": "string", "minLength": 1 },
    "kind": {
      "type": "string",
      "enum": ["produce", "audit", "admit", "pack", "train", "eval", "promote", "register"]
    },
    "status": {
      "type": "string",
      "enum": ["running", "draft", "accepted", "failed", "archived"]
    },
    "task_id": { "type": ["string", "null"] },
    "work_dir": { "type": "string" },
    "receipt": { "type": ["string", "null"] },
    "publish_corpus_id": { "type": ["string", "null"] },
    "publish_path": { "type": ["string", "null"] },
    "parents": { "type": "array", "items": { "type": "string" } },
    "entry": { "type": ["string", "null"] },
    "intent": { "type": "string" }
  }
}
