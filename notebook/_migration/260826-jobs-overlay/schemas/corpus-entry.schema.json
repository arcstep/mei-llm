{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mei-llm://jobs/corpus-entry.schema.json",
  "title": "mei-llm corpus registry entry",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "role", "state", "path"],
  "properties": {
    "id": { "type": "string" },
    "role": { "type": "string" },
    "state": {
      "type": "string",
      "enum": [
        "accepted",
        "draft",
        "fail_closed",
        "job_complete",
        "engineering_contrast",
        "archive",
        "invalid",
        "evaluation_only",
        "empty",
        "probe"
      ]
    },
    "path": { "type": "string" },
    "job_id": { "type": ["string", "null"] },
    "release": { "type": ["string", "null"] },
    "generators": { "type": "array", "items": { "type": "string" } },
    "unique_train_tokens": { "type": ["integer", "null"] },
    "formal_eligible": { "type": "boolean" },
    "subscribers": { "type": "array", "items": { "type": "string" } }
  }
}
