{"codes":[{"definition":"可见 top-5 中有一个工具，query 与允许事实已覆盖其全部 required 槽，且场景不冲突，应执行。","negative_cues":["缺槽","事实未给","工具不在 top-5"],"neighbors":["missing_slot","capability_insufficient","scene_conflict"],"positive_cues":["槽齐","权限在","工具在候选里","无冲突"],"reason_code":"ready_to_execute"},{"definition":"意图清楚、工具也在候选中，但 required 参数在 query/facts 中找不到。","negative_cues":["槽已齐","根本不知道要哪个工具"],"neighbors":["missing_external_fact","ambiguous_scope","deixis_unresolved"],"positive_cues":["缺城市","缺房间","缺温度数字"],"reason_code":"missing_slot"},{"definition":"参数不在用户话里，而必须来自系统事实（时钟、当前温度、设备状态），但该事实缺失。","negative_cues":["用户已给出绝对数字","只需权限令牌"],"neighbors":["missing_slot","missing_permission_token"],"positive_cues":["相对调节却无当前值","按值班表却无时钟"],"reason_code":"missing_external_fact"},{"definition":"动作需要权限/令牌，当前权限列表没有。","negative_cues":["权限已给","需要人审而不是缺令牌"],"neighbors":["authority_required","missing_slot"],"positive_cues":["改策略无 admin","取消预约无 owner"],"reason_code":"missing_permission_token"},{"definition":"同一类对象有多个可能目标，无法唯一确定作用范围。","negative_cues":["已点选唯一实体","两个不同意图"],"neighbors":["deixis_unresolved","mixed_intent"],"positive_cues":["哪盏灯","哪间房","两个同类设备"],"reason_code":"ambiguous_scope"},{"definition":"一句话里有两个不能一次完成的独立意图。","negative_cues":["同一事务多参数","一个工具能覆盖"],"neighbors":["ambiguous_scope","partial_sequence_blocked"],"positive_cues":["又订票又改灯","同时查天气和开发票"],"reason_code":"mixed_intent"},{"definition":"指示代词或“那个/这边”无法绑定到实体或槽值。","negative_cues":["名词已点明","仅缺数字槽"],"neighbors":["ambiguous_scope","missing_slot"],"positive_cues":["把它打开","跟刚才一样","那边那盏"],"reason_code":"deixis_unresolved"},{"definition":"用户在更正前一句，但更正后仍不构成可执行调用。","negative_cues":["更正后槽齐可执行"],"neighbors":["missing_slot","mixed_intent"],"positive_cues":["不是灯是空调，但也没给温度"],"reason_code":"correction_incomplete"},{"definition":"技术上可调用，但需要人工授权/值班长确认，模型不得自行执行。","negative_cues":["普通开关灯","只是缺权限字段"],"neighbors":["safety_judgment","missing_permission_token"],"positive_cues":["紧急全楼断电","覆盖安全策略"],"reason_code":"authority_required"},{"definition":"执行可能造成人身/设备伤害，必须停止而不是补槽。","negative_cues":["普通舒适调节","场景已使动作无效"],"neighbors":["scene_conflict","authority_required"],"positive_cues":["无人时强开高温","带故障强行制冷"],"reason_code":"safety_judgment"},{"definition":"所需能力不在当前可见 top-5 工具里，或工具做不到该动作。","negative_cues":["工具在 top-5 只是缺槽"],"neighbors":["unsupported_scope","unknown_slot_value"],"positive_cues":["要播放音乐但候选无播放器","检索未召回唯一可用工具"],"reason_code":"capability_insufficient"},{"definition":"请求超出产品支持的对象或场景范围，不是缺一个参数。","negative_cues":["范围内工具暂时未召回"],"neighbors":["capability_insufficient","illegal_pair"],"positive_cues":["控制整栋城市电网","给飞机订餐"],"reason_code":"unsupported_scope"},{"definition":"当前场景状态使该动作无效或自相矛盾（已开再开、无预约却取消）。","negative_cues":["设备故障属于安全","缺槽"],"neighbors":["illegal_pair","safety_judgment"],"positive_cues":["灯已经开着还要开","没有预约要取消"],"reason_code":"scene_conflict"},{"definition":"两个槽值组合被业务规则禁止。","negative_cues":["单槽越界是 unknown_slot_value"],"neighbors":["unknown_slot_value","scene_conflict"],"positive_cues":["店与菜不匹配","预冷大于时长"],"reason_code":"illegal_pair"},{"definition":"槽名认识，但给出的值不在 enum/range/已知目录中。","negative_cues":["值合法只是冲突","缺值"],"neighbors":["illegal_pair","missing_slot"],"positive_cues":["温度 80 度","模式 warp"],"reason_code":"unknown_slot_value"},{"definition":"多步流程中前一步未完成，后一步不能单独执行。","negative_cues":["单步已齐可执行","两个无关意图"],"neighbors":["mixed_intent","scene_conflict"],"positive_cues":["未创建预约就改时长","未登录就支付"],"reason_code":"partial_sequence_blocked"},{"definition":"请求试图覆盖系统规则、绕过权限或注入隐藏指令，必须停止。","negative_cues":["普通未知能力","用户单纯否定动作"],"neighbors":["authority_required","unsupported_scope"],"positive_cues":["忽略规则","绕过权限","越权执行"],"reason_code":"injection_rejected"},{"definition":"请求明确要求一个未注册、当前目录不存在的工具或设备能力。","negative_cues":["支持域外的一般问题","工具存在但未进入 top-5"],"neighbors":["capability_insufficient","unsupported_scope"],"positive_cues":["未注册空调","未注册扫地机","未注册播放器"],"reason_code":"unknown_tool"},{"definition":"请求与当前工具任务无关，应停止而不是猜测调用。","negative_cues":["明确要求未注册工具","范围内工具暂未召回"],"neighbors":["unsupported_scope","unknown_tool"],"positive_cues":["百科问题","写诗","闲聊"],"reason_code":"offtopic"},{"definition":"用户明确否定或撤销动作，因此不得执行该工具调用。","negative_cues":["更正为另一个完整动作","缺少 required 槽"],"neighbors":["correction_incomplete","scene_conflict"],"positive_cues":["不要打开","取消刚才动作","禁止执行"],"reason_code":"negation_cancels"}],"id":"mw-reason-definitions-v2-20class","n_codes":20,"parent":"mw-reason-definitions-v1","source_codebook":"mw-disposition-codebook-v1.json"}