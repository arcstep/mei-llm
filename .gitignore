__pycache__/
*.py[cod]
.DS_Store
.venv/
.env
*.egg-info/
.pytest_cache/
.ruff_cache/

# Large, cycle-bound evidence and release exports are local-only.
.local/artifacts/**
!.local/artifacts/.gitkeep
.local/dist/**
!.local/dist/README.md
.local/cache/**

# Local Rust/WASM build caches.
platform/_shared/target/
platform/_shared/target-check/

# Canonical model releases are first-class local assets, not rebuild outputs.
# Keep their human/machine-readable inventories in Git; keep weight/package
# payloads out of the public repository and back them up separately.
models/*/releases/*/base/
models/*/releases/*/qat/
models/*/releases/*/sft/
models/*/releases/*/package/
