__pycache__/
*.py[cod]
.DS_Store
.venv/
.env
*.egg-info/

# Published tokenizer: keep v1 model + sidecar
!tokenizer/zh-24k-v1/zh-24k-v1.model
!tokenizer/zh-24k-v1/zh-24k-v1.vocab
!tokenizer/zh-24k-v1/*.json
!tokenizer/zh-24k-v1/*.md
!tokenizer/zh-24k-v1/vocab.txt

# Published corpus: atlas/json/md only; never tokens/raw/shards/bin or process leftovers
corpus/**
!corpus/README.md
!corpus/lm-v1/
!corpus/lm-v1/**
corpus/lm-v1/**/tokens/
corpus/lm-v1/**/raw/
corpus/lm-v1/**/shards/
