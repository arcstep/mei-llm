__pycache__/
*.py[cod]
.DS_Store
.venv/
.env
*.egg-info/
.pytest_cache/
.ruff_cache/

# 语料/过程为大体积本地资产，不进 git（哈希证据绑定于 receipts/CYCLE.json）。
# 例外：合成语料与评测锁不可复现且体量可控，必须入仓。
corpus/**
!corpus/README.md
!corpus/GOVERNANCE.md
!corpus/catalog/
!corpus/catalog/*.md
!corpus/catalog/*.json
!corpus/adoptions/
!corpus/adoptions/**/
!corpus/adoptions/**/*.md
!corpus/adoptions/**/*.json
!corpus/pools/
!corpus/pools/README.md
!corpus/pools/*/
!corpus/pools/*/README.md
!corpus/pools/candidates/*/
!corpus/pools/candidates/*/README.md
!corpus/pools/zh-v2-pool/
!corpus/pools/zh-v2-pool/candidates/
!corpus/pools/zh-v2-pool/candidates/**
!corpus/eval-lock/
!corpus/eval-lock/**
!corpus/sft-suite/
!corpus/sft-suite/**
cycles/**
.local/artifacts/**
!.local/artifacts/.gitkeep
.local/dist/**
!.local/dist/README.md
.local/cache/**
.local/recovery/**

# Local Rust/WASM build caches.
src/platform/_shared/target/
src/platform/_shared/target-check/

# 权重/包载荷不进 git（人类可读清单与 receipt 保留；权重另行备份）。
models/*/tokenizer/*.model
models/*/tokenizer/*.vocab
models/*/exp-*/base/
models/*/exp-*/qat/
models/*/exp-*/sft/
models/*/exp-*/package/
models/*/exp-*/**/*.npz
models/*/exp-*/**/*.bin
models/*/exp-*/**/tokenizer.model
models/*/exp-*/**/heads/**/*.npz
models/*/releases/**/*.npz
models/*/releases/**/*.bin
models/*/releases/**/tokenizer.model
models/*/releases/**/heads/**/*.npz

# 导出 staging 临时目录（证据已进包内 receipts）
models/*/exp-*/products/.*.staging/
models/*/releases/**/products/.*.staging/

# runtime 构建产物不入 git（manifest 保留，wasm 可由 cargo 9 秒重建）
models/*/runtime/wasm/*.wasm

# docs/ 由独立文档仓（docs/.git）管理，产品仓不跟踪
docs/
# 本机 Claude/Cursor 工作区配置（信封遗留）
.claude/
.cursor/
