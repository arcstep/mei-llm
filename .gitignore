__pycache__/
*.py[cod]
.DS_Store
.venv/
.env
*.egg-info/
.pytest_cache/
.ruff_cache/

# 语料/过程为大体积本地资产，不进 git（哈希证据绑定于 receipts/CYCLE.json）。
corpus/**
cycles/**
.local/artifacts/**
!.local/artifacts/.gitkeep
.local/dist/**
!.local/dist/README.md
.local/cache/**
.local/recovery/**

# Local Rust/WASM build caches.
src/platform/_shared/target/
src/platform/_shared/target-check/

# 权重/包载荷不进 git（人类可读清单与 receipt 保留；权重另行备份）。
models/*/exp-*/base/
models/*/exp-*/qat/
models/*/exp-*/sft/
models/*/exp-*/package/
models/*/exp-*/**/*.npz
models/*/exp-*/**/*.bin
models/*/exp-*/**/tokenizer.model
models/*/exp-*/**/heads/**/*.npz

# 导出 staging 临时目录（证据已进包内 receipts）
models/*/exp-*/products/.*.staging/

# runtime 构建产物不入 git（manifest 保留，wasm 可由 cargo 9 秒重建）
models/*/runtime/wasm/*.wasm
