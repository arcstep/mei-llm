{
  "sdk_semver": "0.2.0-experimental",
  "active_wire": "mei-runtime-wire-v2",
  "active_package": "mei-model-package-v2",
  "legacy_policy": "v1-read-only-degraded",
  "languages": {
    "rust": {
      "status": "experimental",
      "crate": "mei-sdk-core",
      "inference": "portable-cq2-and-legacy-q4",
      "protocol": "available"
    },
    "c": {
      "status": "experimental",
      "abi": "mei-runtime-abi-2",
      "inference": "via-rust-core-quantized",
      "protocol": "available"
    },
    "python": {
      "status": "experimental",
      "bindings": ["protocol-native", "ctypes-ffi", "mlx-reference-oracle", "mlx-51m-q4"],
      "inference": "mlx-q4-and-mlx-fused-wht",
      "note": "Python+MLX is the golden oracle for Q4 vs frozen float-anchor deltas. WASM never loads float weights."
    },
    "node": {
      "status": "experimental",
      "api_surface": "node-local",
      "inference": "unavailable",
      "protocol": "available"
    },
    "browser": {
      "status": "declared-separately",
      "api_surface": "browser",
      "inference": "wasm-tier-1-quantized-only",
      "protocol": "available"
    },
    "wasm": {
      "status": "tier-1-quantized",
      "tiers": {
        "0": "protocol and package validation only",
        "1": "51M portable tensor package v2 or legacy q4 read-only; float npz refused"
      },
      "inference": "quantized-only"
    }
  }
}
