{
  "id": "mei-route-protocol-v1",
  "serializer": "mei-route-serializer-v1",
  "internal_output": ["[]", "{\"route_id\":<int>}"],
  "external_output": "schema-legal JSON array of at most one call, rendered deterministically",
  "model_must_not_emit_argument_values": true,
  "request_payload": [
    "locked_task_contract",
    "<tools>canonical compact schema</tools>",
    "<routes>finite compiled hypotheses</routes>",
    "optional scene",
    "optional visible entity summary",
    "natural user query"
  ],
  "route_id_order": ["tool_index", "canonical_json_arguments"],
  "max_routes": 16,
  "max_candidates_per_arg": 8,
  "overflow": "refuse_entire_request",
  "hash_fields": [
    "serializer",
    "schema_hash",
    "entity_snapshot_hash",
    "normalizer_version",
    "route_manifest"
  ],
  "same_protocol_systems": ["mei-1.0-58m", "qwen3.5-9b-zero-shot"],
  "decode": "route_id_prefix_trie_only"
}
