{
  "id": "mei-schema-subset-v1",
  "parent": "mei-schema-subset-v0",
  "serializer": "mei-route-serializer-v1",
  "product_seq_len": 2048,
  "output": {
    "internal": "route_id_or_empty",
    "external": "json_array",
    "max_calls": 1,
    "empty_means_refuse": true,
    "arguments": "object"
  },
  "supported": {
    "required": true,
    "enum": true,
    "types": ["string", "boolean", "integer", "number"],
    "minimum": true,
    "maximum": true
  },
  "open_string_forbidden_unless_candidate_source": true,
  "unsupported": [
    "array_arguments",
    "nested_object_arguments",
    "multi_call",
    "generic_json_schema",
    "lm_free_text_values"
  ],
  "no_default_toolset": true,
  "product_rules": "compiler_and_validator_not_lm",
  "grammar": "request_route_id_trie"
}
